{
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/oauth/start", "destination": "/api/proxy?subpath=oauth/start" },
    { "source": "/oauth/complete", "destination": "/api/proxy?subpath=oauth/complete" },
    { "source": "/oauth/logout", "destination": "/api/proxy?subpath=oauth/logout" },
    { "source": "/oauth/:path*", "destination": "/api/proxy?subpath=oauth/:path*" },
    { "source": "/api/oauth/:path*", "destination": "/api/proxy?subpath=oauth/:path*" },
    { "source": "/api/:path*", "destination": "/api/proxy?subpath=:path*" },
    { "source": "/health", "destination": "/api/proxy?subpath=health" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
